# Copy to .env and fill in. .env is git-ignored. Never commit real keys.
#
# The base URL and header name below are from the Gnani docs
# (docs.gnani.ai/api/STT/speech-to-text.md, checked 2026-10-02). The key comes from
# app.gnani.ai > API Keys. Without all three the clients raise NotConfigured.

# API key generated in the Gnani console.
GNANI_API_KEY=

# Speech APIs (Prisma STT, Timbre TTS). Evon has no documented hosted endpoint.
GNANI_BASE_URL=https://api.vachana.ai

GNANI_AUTH_HEADER=X-API-Key-ID

# Where request/response cache files are stored (default: .cache/api).
# BOLI_CACHE_DIR=

# --- Spoken conversation: reply generation --------------------------------------------------------------------------
# Gnani documents no hosted text-reply service for Evon. Two options, tried in this order:

# Option A (preferred): Evon, self-hosted on Modal (see experiments/2026-10-05-evon-pipeline/ for how it was deployed —
# vLLM serving the official gnani/gnani-evon-v3.3-30B-A3B BF16 checkpoint on an A100 80GB). No API key: the endpoint
# is unauthenticated. Cold boots after ~1h idle can take several minutes; the client's timeout accounts for this.
# BOLI_EVON_URL=https://<your-workspace>--evon-v3-3-serve-serve.modal.run
# BOLI_EVON_MODEL=/weights/gnani/gnani-evon-v3.3-30B-A3B   (default; matches the path baked into the deployed image)

# Option B (fallback, used only if BOLI_EVON_URL is unset): Claude, via the Anthropic Messages API.
# ANTHROPIC_API_KEY=
# BOLI_REPLY_MODEL=claude-haiku-4-5-20251001   (default; other models with a known price: claude-sonnet-5-5, claude-opus-5-5, claude-fable-5-1)
# BOLI_CLAUDE_BUDGET_USD=0.25      hard cap on estimated spend; requests stop before it would be passed
# BOLI_CLAUDE_MAX_REQUESTS=40      hard cap on requests sent
# BOLI_CLAUDE_USAGE=               where the request record is kept (default .cache/claude_usage.jsonl)
# BOLI_VOICE=                      a documented Timbre voice name; default Nalini
